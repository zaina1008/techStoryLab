
---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const url = "https://ybfuhuqlwktfyvtxwsei.supabase.co/rest/v1/";
    const key = "sb_publishable_HNO2gEhjq--8baQl6X4KgA_X9N2TzPW";

    const response = await fetch(url + "faciliteter", {
        headers: {
            apiKey: key
        }
    });

    const facilities = await response.json();

    return facilities.map((facility) => ({
        params: { id: String(facility.id) },
        props: { facility }
    }));
}

const { facility } = Astro.props;
import calender from "../../images/calender.png";
import { Image } from "astro:assets";
import yellow_logo from "../../images/yellow-logo.png";
