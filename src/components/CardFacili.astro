---
const { id, title, littleDescription, image, bigDescription } = Astro.props;


import yellow_logo from"../images/yellow-logo.png";
import bluecard from "../images/bluecard.png";
---



  <article class="facilities_card" style={`background-image: url(${bluecard.src})`}>
    <a href={`/faciliteter/${id}`}>
        <h2>{title}</h2>
        <p>{littleDescription}</p>
        <img src={image} alt={title}>
    </a>
</article>


  <style>




.facilities_card {
    background-color: var(--ligth_blue);
    padding: 35px;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    height: 550px;
    
    
}

.facilities_card a {
    display: flex;
    flex-direction: column;
    gap: 15px;
    text-decoration: none;
    color: white;
        height: 90%;
}

.facilities_card h2 {
    margin: 0;
    text-align: left;
}

.facilities_card p {
    /* max-width: 28ch; */
    margin: 0;
    text-align: left;
}

.facilities_card img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 15px;
    margin-top: auto;
   
}

  </style>