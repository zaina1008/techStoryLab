---
import { Image } from "astro:assets";

import yellow_logo from"../images/yellow-logo.png";
import heroImg from"../images/heroImg.png";

---

<div class="hero" style={`background-image: url(${yellow_logo.src})`}>
     
    <div>
     <Image class="heroImg"src={heroImg} alt="HeroImg" />
    </div>
    <div class="grid_2">
        <h1>Tech og Story Lab</h1>
        <p><span>Tech & Story Lab </span> giver studerende adgang til kreative faciliteter og teknologier. Faciliteter kan kun bookes online, mens udstyr udelukkende kan lånes fysisk i labbet.</p>
        <h2>Book vores faciliteter</h2>

        <div class="bnt">
            <button><a href="/#Faciliteter"></a>BOOK NU</button>
             <button><a href="udstyr.astro"></a>BOOK UDSTYR</button>
        </div>
    </div>
</div>



<style>
 .hero{
       padding-top: 25px;
      }


.hero img{
    width: 90%;
    height: auto;
    display: block;
    margin: auto;
    border-radius: 10px;
   
}





span{
   font-weight: bold;
}

h1, h2{

    width: fit-content;
    margin: auto;
}
h1{
font-family: Comfortaa;
font-style:normal;
font-weight:50;
font-size: 45px;
margin-block: 15px 10px;
}
p{
      width: fit-content;
    margin: auto;
    margin-block: 10px 15px;
    max-width: 35ch;;
}

.bnt{
    width: fit-content;
      width: fit-content;
    margin: auto;
    margin-block: 5px;
    display: flex;
    gap: 20px;
     padding-bottom: 25px;
   
}
button{
    width: fit-content;
    padding-block: 8px;
    padding-inline: 20px;
    border-radius: 10px;
    border: none;
   
}


 @media (min-width: 600px) {

    .hero {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        gap: 50px;
        width: 94%;
        margin: auto;
        padding: 30px 0;
    }

    .heroImg {
        width: 100%;
        height: auto;
    }

    .grid_2 {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0;
    }

    h1 {
        margin: 0 0 20px;
        font-size: 45px;
    }

    .grid_2 p {
        max-width: 45ch;
        width: 100%;
        margin: 0 0 35px;
        line-height: 1.5;
    }

    h2 {
        margin: 0 0 20px;
        padding: 0;
    }

    .bnt {
        display: flex;
        gap: 20px;
        margin: 0;
        padding: 0;
    }

 }


</style>








