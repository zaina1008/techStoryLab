---
import { Image } from "astro:assets";
import figure_3 from"../images/figure_3.png";
import CardUdstyr from "./CardUdstyr.astro";




const url = "https://ybfuhuqlwktfyvtxwsei.supabase.co/rest/v1/";
const udstyrTablename = "udstyr"; 


const key ="sb_publishable_HNO2gEhjq--8baQl6X4KgA_X9N2TzPW"

const options = {
	headers: {
        apiKey: key
	}
}

const udstyrResponse = await fetch(url + udstyrTablename, options);
const udstyrData = await udstyrResponse.json();

console.log("udstyrData",udstyrData);

---

<main>
<div class="grid_1_1">

    <div>
    <p>Her kan du se vores udstyr. <br class="br_2"> Bemærk at booking af vores udstyr, kun <br> kan ske <span>fysisk og ikke online.</span></p>
</div>

 <Image class="figure_1"src={figure_3} alt="figure_" />
</div>



<div class="grid_faciliteter">
{
udstyrData.map((udstyrdata) =>{
return <CardUdstyr  id={udstyrdata.id} title={udstyrdata.title} image={udstyrdata.image} />
})
}
</div>

</main>















<style>
    .grid_1_1{
        display: grid;
        grid-template-columns: 2fr 1fr;
        margin-inline: 5%;
        

        padding-top: 30px;
       
    }
.figure_1{
    
    width: 100%;
    display: block;
}

span{
    text-decoration: underline solid 2px black ;
   text-underline-offset: 4px;
}



 /* grid facility */
.grid_faciliteter {
    display: grid;
    grid-template-columns: 1fr;
    width: 90%;
    margin: auto;
    gap: 30px;
    padding-block: 30px 80px;
    background-size: 100%;
    background-repeat: no-repeat;
    background-position: center;
}

 @media (min-width: 600px) {

    .figure_1{
    width: 30%;
    margin-left: auto !important;
 
}

.br_2{
    display: none;
}


.grid_faciliteter {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 90%;
    margin: auto;
    gap: 30px;
    padding-block: 30px 80px;
}
 }



</style>