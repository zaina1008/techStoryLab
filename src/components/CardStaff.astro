---
const {image, title, name, email, phoneNumber}= Astro.props
---


<article class="staff_card ">
  
    <img src={image}>
    <h3>{title}</h3>
    <p class="name">{name}</p>
    <p class="email"><a href={`mailto:${email}`}>{email}</a></p>
    <a class="phone" href={`tel:${phoneNumber}`}>{phoneNumber}</a>
   
</article>



<style>
  
   /* article {
    max-width: 300px;
    display: flex;
    flex-direction: column;
    gap: 10px;

   }  */
 .staff_card {
        background-color: var(--header_color);
        padding: 25px;
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        /* max-width: 300px; */
        height: auto;
        padding-bottom: 60px;
    }

    .staff_card img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 10px;
    }

    .staff_card h3 {
        font-size: smaller;
        font-weight: normal;
        margin: 0;
         text-transform: uppercase;
    }
    .name{
        /* font-size:1rem ;
        font-weight: bold; */

           font-size: 1.25rem;
    font-weight: bold;
    margin: 0;
    line-height: 1.3;
    }

    .staff_card p {
    
        margin: 0;
    }

    .staff_card a {
        color: black;
        text-decoration: none;
          font-size: 0.95rem;
    width: fit-content;
        
    }

    .staff_card a:hover {
    text-decoration: underline;
}


</style>