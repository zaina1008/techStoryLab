---
import { Image } from "astro:assets";
import  Hero from "./Hero.astro";
import figure_1 from"../images/figure_1.png";
import mestpopulaereF from"../images/mestPopulaereF.png";
import  CardStaff  from "./CardStaff.astro";
import  CardFacili  from "./CardFacili.astro";

import figure_2 from"../images/figure_2.png";


// staff

const url = "https://ybfuhuqlwktfyvtxwsei.supabase.co/rest/v1/";
const staffTablename = "staff"; 


const key ="sb_publishable_HNO2gEhjq--8baQl6X4KgA_X9N2TzPW";

const options = {
	headers: {
        apiKey: key
	}
}

const staffResponse = await fetch(url + staffTablename, options);
const staffData = await staffResponse.json();

console.log("staffData",staffData);



// facilitetere

const f_url = "https://ybfuhuqlwktfyvtxwsei.supabase.co/rest/v1/";
const facilitieTablename = "faciliteter"; 


const fkey ="sb_publishable_HNO2gEhjq--8baQl6X4KgA_X9N2TzPW";

const f_options = {
	headers: {
        apiKey: fkey
	}
}

const facilitieResponse = await fetch(f_url + facilitieTablename, f_options);
const facilitieData = await facilitieResponse.json();

console.log("facilitieData:", facilitieData);
// console.log("Is it an array?", Array.isArray(facilitieData));
// console.log("facilitieData",facilitieData);


import yellow_logo from"../images/yellow-logo.png";

---
<main>
<Hero/>
<div class="grid_1_1">

    <div id="Faciliteter">
    <h2 class="f_H2">Faciliteter</h2>
    <p>Her kan du få et overblik over vores <br class="f_br"> faciliteter. </p>
</div>

 <Image class="figure_1"src={figure_1} alt="figure_1" />
</div>


<div class="grid_faciliteter">
{
facilitieData.map((facilitidata) =>{
return <CardFacili  id={facilitidata.id} title={facilitidata.title} littleDescription={facilitidata.littledescription} image={facilitidata.image} />
})
}

</div>


<article class="article_1">
    <h2 class="f_H2">Mest populære faciliteter</h2>
    <p>Her kan du få et overblik over vores <br> mest populære faciliteter og få noget inspiration.</p>
    <Image class="mestpopulæreF"src={mestpopulaereF} alt="mestpopulaereF" />
</article>

<article class="article_2">

<div id="staff" class="grid_1_1">

    <div>
    <h2 class="f_H2">Hvem er vi? </h2>
    <p>Her kan du komme i kontakt med vores <br> passionerede team.</p>
</div>

 <Image class="figure_1"src={figure_2} alt="figure_2" />
</div>




<div class="grid_saff">
{
staffData.map((staffdata) =>{
return <CardStaff image={staffdata.image} title={staffdata.title} name={staffdata.name} email={staffdata.email} phoneNumber={staffdata.phonenumber} />
})
}
</div>

</article>

</main>

<style>
    .grid_1_1{
        display: grid;
        grid-template-columns: 2fr 1fr;
        margin-inline: 5%;
        margin-top: 40px;
       
    }
.figure_1{
    
    width: 100%;
    display: block;
}

.grid_1_1 p{
    margin-top: 5px;

}



.article_1 h2{
    width: 90%;
    margin: auto;
}

.article_1 p{
    width: 90%;
    margin: auto;
    margin-block: 4px 15px;
}

.mestpopulæreF{
    width: 90%;
    margin: auto;
}



    /* grid facility */
.grid_faciliteter {
    display: grid;
    grid-template-columns: 1fr;
    width: 90%;
    margin: auto;
    gap: 30px;
    padding-block: 30px 80px;
}



/* Staff Grid */
.grid_saff{
    display: grid;
    grid-template-columns: 1fr;
    width: fit-content; 
    margin: auto;
   gap: 30px;

   padding-block: 30px;
    padding-bottom: 80px;

    /* grid facility */






}




 @media (min-width: 600px) {


.f_H2{
font-size: 2rem;
}

br{
    display: none;
}

.figure_1{
    width: 30%;
    margin-left: auto !important;
   
    
}

 .grid_saff{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr ;
  padding-bottom: 80px;
  
   
}

/* .grid_faciliteter{
      display: grid;
    grid-template-columns: 1fr 1fr 1fr;
  padding-bottom: 80px;
  width: 70%;
  height: 500px;
  gap: 30px;
  margin: auto;

} */

.grid_faciliteter {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 90%;
    margin: auto;
    gap: 30px;
    padding-block: 30px 80px;
}


.mestpopulæreF{
    width: 60%;
    margin: 0 0 0 4rem !important;
}
 }








</style>